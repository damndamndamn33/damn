import asyncio
import logging
import os
import sys

from aiogram import Bot, Dispatcher, F
from aiogram.client.default import DefaultBotProperties
from aiogram.enums import ParseMode
from aiogram.filters import CommandStart
from aiogram.types import (
    Message,
    LabeledPrice,
    PreCheckoutQuery,
    InlineKeyboardMarkup,
    InlineKeyboardButton,
)

# Токен берём из переменной окружения BOT_TOKEN.
# Перед запуском: export BOT_TOKEN="8792332483:AAE6LGEC3bX74qg5b6KyHAg0_y13HLn2_ps"
TOKEN = os.getenv("BOT_TOKEN")
if not TOKEN:
    raise RuntimeError("Не задана переменная окружения BOT_TOKEN")

CURRENCY = "XTR"
PRIVATE_CHAT_ID = -  # ID приватного чата/канала, куда выдаём доступ

bot = Bot(token=TOKEN, default=DefaultBotProperties(parse_mode=ParseMode.HTML))
dp = Dispatcher()


@dp.message(CommandStart())
async def cmd_start(message: Message):
    """Показываем кнопку выбора способа оплаты."""
    keyboard = InlineKeyboardMarkup(inline_keyboard=[
        [InlineKeyboardButton(text="💫Telegram Stars", callback_data="pay_stars")]
    ])
    await message.answer("Способ оплаты: (Payment method:)", reply_markup=keyboard)


@dp.callback_query(F.data == "pay_stars")
async def handle_payment_callback(callback_query):
    """Пользователь нажал кнопку оплаты — выставляем счёт."""
    await bot.send_invoice(
        chat_id=callback_query.from_user.id,
        title="Подписка на 30 дней (30-Day Subscription)",
        description="Оплатить и получить ссылку (Pay and get a link)",
        payload="access_to_private",
        currency=CURRENCY,
        prices=[LabeledPrice(label="XTR", amount=350)],
    )
    await callback_query.answer()  # убираем "часики" на кнопке


@dp.pre_checkout_query()
async def pre_checkout_handler(event: PreCheckoutQuery):
    """Обязательное подтверждение перед списанием оплаты."""
    await event.answer(True)


@dp.message(F.successful_payment)
async def successful_payment(message: Message):
    """Срабатывает ТОЛЬКО при реально подтверждённой оплате."""
    link = await bot.create_chat_invite_link(PRIVATE_CHAT_ID, member_limit=1)
    await message.answer(f"Твоя ссылка: (Your link:)\n{link.invite_link}")


async def main():
    await dp.start_polling(bot)


if __name__ == "__main__":
    logging.basicConfig(level=logging.INFO, stream=sys.stdout)
    asyncio.run(main())
